# ========================================================
# Telegram Bot 多頻道設定 (Multi-Bot Configuration)
# 提示：若未設定個別專屬 Bot，系統將自動回退使用預設通用 Bot
# 提示：Chat ID 支援多個 ID（逗號分隔），也支援群組 ID（負數，如 -100xxxxxxx）
# ========================================================

# 1. 通用預設 Bot（必填）
TELEGRAM_BOT_TOKEN=your_default_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# 2. 💰 財經投資專屬 Bot（選填，聚財網、華爾街日報、DIGITIMES 產經供應鏈）
TG_BOT_TOKEN_FINANCE=
TG_CHAT_ID_FINANCE=

# 3. 📚 閱讀書摘專屬 Bot（選填，閱讀前哨站、坦雅讀一讀、77reading、方格子沙龍）
TG_BOT_TOKEN_READING=
TG_CHAT_ID_READING=

# 4. ⚡ 科技產業專屬 Bot（選填，科技新報、DIGITIMES 科技焦點與研究報告）
TG_BOT_TOKEN_TECH=
TG_CHAT_ID_TECH=

# 5. 🎬 影音精選專屬 Bot（選填，YouTube 說書與知識影音深度分析）
TG_BOT_TOKEN_YOUTUBE=
TG_CHAT_ID_YOUTUBE=

# ========================================================
# Google Gemini API Key（選填，若未填寫將自動採用文章內文高品質繁中提取）
# ========================================================
GEMINI_API_KEY=

# 定時排程檢查時間（24小時制，以逗號分隔，例如一天 3 次：08:00,12:00,18:00）
SCHEDULE_TIMES=08:00,12:00,18:00

# 時區設定
TIMEZONE=Asia/Taipei
